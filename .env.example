HTTP_ADDRESS=127.0.0.1:8080
# Copy the connection string from Neon. URL-encode special password characters.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-jolly-wave-az49b8bq-pooler.c-3.ap-southeast-1.aws.neon.tech:5432/Loan_Banking?sslmode=verify-full
# Generate with: openssl rand -hex 32
